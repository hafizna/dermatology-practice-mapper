# Template for Streamlit Community Cloud secrets — copy these keys into
# the app's "Secrets" panel (Settings -> Secrets) on share.streamlit.io.
# NEVER commit an actual secrets.toml with a real token — this .example
# file is the only one tracked in git (see .gitignore).

# Repo the dashboard's database Release lives in — same private repo
# this code is deployed from.
GITHUB_REPO = "hafizna/dermatology-practice-mapper"

# A GitHub Personal Access Token (fine-grained, scoped to ONLY this repo,
# "Contents: Read-only" permission) — needed because the repo is private,
# so downloading a Release asset requires authentication even for a
# read-only fetch. Generate at https://github.com/settings/tokens
GITHUB_TOKEN = "github_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Optional — defaults shown, only set these if you changed the values
# scripts/publish_database_release.py uses.
# GITHUB_RELEASE_TAG = "data"
# GITHUB_RELEASE_ASSET = "derm_mapper.sqlite"
